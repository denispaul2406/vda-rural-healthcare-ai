# VDA Environment Configuration

# Provider selection (sarvam | google | bhashini | mock)
STT_PROVIDER=sarvam     # sarvam | google | bhashini | mock
TTS_PROVIDER=sarvam     # sarvam | google | bhashini | mock
LLM_PROVIDER=gemini     # gemini | openai | mock

# Sarvam AI Credentials (India's Sovereign Voice Model)
SARVAM_API_KEY=your_sarvam_api_key_here

# API Credentials (Fill as available)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Credentials (STT/TTS)
GOOGLE_APPLICATION_CREDENTIALS=gcp_service_account.json
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# Bhashini (ULCA API) Credentials
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id

# System Configuration
INTENT_CONFIDENCE_THRESHOLD=0.75
RAG_SIMILARITY_THRESHOLD=0.10
SESSION_TTL_MINUTES=30
LOG_LEVEL=INFO
